<vertical spacing='1' horizontal-fit='PreferredSize'>
  <increment-setting text='Decimal Precision' apply-on-change='true' value='DecimalPlaces' integer-only='true' min='0' max='4' increment='1'/>
  <increment-setting text='Font Size' apply-on-change='true' value='FontSize' integer-only='false' min='0.5' max='10' increment='0.5'/>
  <list-setting text='Mode' apply-on-change='true' value='CounterMode' choices='CounterModeTypes'/>
</vertical>